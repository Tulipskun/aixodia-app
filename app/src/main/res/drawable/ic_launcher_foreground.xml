<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher wears the same mark as the bar and the web, from the same
    drawable rather than a copied set of paths, so the two cannot drift apart.

    The inset keeps the mark's outer ring inside the adaptive icon's 66dp safe
    zone: the ring spans about 85% of the mark's box, so 16dp on each side of a
    108dp layer leaves it clear of every launcher mask. The navy behind it is
    ic_launcher_background, the same recess the surfaces use.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/aixodia_mark"
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />
</layer-list>
