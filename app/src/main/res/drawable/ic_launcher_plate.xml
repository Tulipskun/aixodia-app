<?xml version="1.0" encoding="utf-8"?>
<!-- The plate behind the mark: a rounded square covering the adaptive icon's
     full 108dp canvas.

     A launcher that masks the icon crops to the middle 72dp, and this shape
     covers that whole area — its corner arcs start 30dp in, outside the visible
     18dp inset — so a masking launcher looks as it did with a plain colour. The
     plate is for the places that draw the icon unmasked: the system's own app
     lists, and launchers that keep icons square, which used to show a square of
     colour around a round mark. 30 of 108 is the radius a phone's own icons are
     drawn with, which is what an icon has to look like beside them.

     Vector rather than a <shape>, because a Compose Image can draw it: the
     launcher snapshot locks the asset that ships, corners included. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M30,0 L78,0 A30,30 0 0 1 108,30 L108,78 A30,30 0 0 1 78,108 L30,108 A30,30 0 0 1 0,78 L0,30 A30,30 0 0 1 30,0 Z" />
</vector>
